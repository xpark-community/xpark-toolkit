# COS credentials for staging models — copy to `.env`, fill in, never commit real secrets.
# Load with: python stage_selfsupplied_models.py --env-file .env
# (an ambient environment with the same variables works too)

# --- Required: COS bucket to stage into ---
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=<your-bucket-name-appid>
COS_REGION=<your-region>

# --- Optional overrides ---
# Custom endpoint; defaults to the regional https://cos.<COS_REGION>.myqcloud.com
#COS_ENDPOINT=https://cos.<COS_REGION>.myqcloud.com

# Hugging Face token of an authorized account; only needed for gated repos
# (facebook/sam3 via --include-gated)
#HF_TOKEN=
